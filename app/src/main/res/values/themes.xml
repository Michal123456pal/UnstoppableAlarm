<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.UnstoppableAlarm" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@android:color/holo_red_dark</item>
        <item name="colorPrimaryVariant">@android:color/holo_red_dark</item>
        <item name="colorOnPrimary">@android:color/white</item>
    </style>

    <style name="Theme.UnstoppableAlarm.Fullscreen" parent="Theme.UnstoppableAlarm">
        <item name="android:windowFullscreen">true</item>
